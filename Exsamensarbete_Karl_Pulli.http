@FishingLog = http://localhost:5008

### ─── SPECIES ───

### Hämta alla arter
GET {{FishingLog}}/api/species
Accept: application/json

### Hämta en specifik art
GET {{FishingLog}}/api/species/3c6ccf00-c1ab-43c2-bb62-3f275a9fc38a
Accept: application/json

### Skapa ny art
POST {{FishingLog}}/api/species
Content-Type: application/json

{
  "name": "Abborre"
}

### Uppdatera art
PUT {{FishingLog}}/api/species/3c6ccf00-c1ab-43c2-bb62-3f275a9fc38a
Content-Type: application/json

{
  "id": "3c6ccf00-c1ab-43c2-bb62-3f275a9fc38a",
  "name": "Gädda"
}

### Ta bort art
DELETE {{FishingLog}}/api/species/3c6ccf00-c1ab-43c2-bb62-3f275a9fc38a

### ─── LOCATIONS ───

### Hämta alla platser
GET {{FishingLog}}/api/locations
Accept: application/json

### Hämta en specifik plats
GET {{FishingLog}}/api/locations/659fea7d-3e1e-4611-b5fb-85294dd49dc7
Accept: application/json

### Skapa ny plats
POST {{FishingLog}}/api/locations
Content-Type: application/json

{
  "name": "Vänern",
  "latitude": 58.9,
  "longitude": 13.5,
  "description": "Sveriges största sjö"
}

### Uppdatera plats
PUT {{FishingLog}}/api/locations/659fea7d-3e1e-4611-b5fb-85294dd49dc7
Content-Type: application/json

{
  "id": "659fea7d-3e1e-4611-b5fb-85294dd49dc7",
  "name": "Vättern",
  "latitude": 58.4,
  "longitude": 14.6,
  "description": "Djup och klar sjö"
}

### Ta bort plats
DELETE {{FishingLog}}/api/locations/4cd980f3-2336-42e1-add8-9c9d5230e894

### ─── LURES ───

### Hämta alla beten
GET {{FishingLog}}/api/lures
Accept: application/json

### Hämta ett specifikt bete
GET {{FishingLog}}/api/lures/3c6ccf00-c1ab-43c2-bb62-3f275a9fc38a
Accept: application/json

### Skapa nytt bete
POST {{FishingLog}}/api/lures
Content-Type: application/json

{
  "name": "Abu Garcia Toby",
  "type": "Skeddrag",
  "color": "Silver",
  "brand": "Abu Garcia"
}

### Uppdatera bete
PUT {{FishingLog}}/api/lures/8b6eddff-5179-498c-9b58-4be945a74322
Content-Type: application/json

{
  "id": "8b6eddff-5179-498c-9b58-4be945a74322",
  "name": "Rapala Original Floater",
  "type": "Wobbler",
  "color": "Röd/vit",
  "brand": "Rapala"
}

### Ta bort bete
DELETE {{FishingLog}}/api/lures/8b6eddff-5179-498c-9b58-4be945a74322

### ─── CATCHES ───

### Hämta alla fångster
GET {{FishingLog}}/api/catches
Accept: application/json

### Filter: bara en specifik art
GET {{FishingLog}}/api/catches?speciesId=d02730c2-6253-4743-a383-d26ab70a5b75
Accept: application/json

### Filter: datumintervall
GET {{FishingLog}}/api/catches?from=2026-04-01&to=2026-04-30
Accept: application/json

### Filter: bara released
GET {{FishingLog}}/api/catches?released=true
Accept: application/json

### Filter: kombinerat (art + plats + datum)
GET {{FishingLog}}/api/catches?speciesId=d02730c2-6253-4743-a383-d26ab70a5b75&locationId=659fea7d-3e1e-4611-b5fb-85294dd49dc7&from=2026-01-01
Accept: application/json

### Hämta en specifik fångst
GET {{FishingLog}}/api/catches/25e8dcc4-959c-4c8d-aed2-b5dee9fde740
Accept: application/json

### Skapa ny fångst (minimal)
POST {{FishingLog}}/api/catches
Content-Type: application/json

{
  "speciesId": "d02730c2-6253-4743-a383-d26ab70a5b75",
  "caughtAt": "2026-05-07T18:30:00",
  "released": true
}

### Skapa ny fångst (komplett)
POST {{FishingLog}}/api/catches
Content-Type: application/json

{
  "speciesId": "d02730c2-6253-4743-a383-d26ab70a5b75",
  "locationId": "659fea7d-3e1e-4611-b5fb-85294dd49dc7",
  "lureId": "8b6eddff-5179-498c-9b58-4be945a74322",
  "caughtAt": "2026-05-07T18:30:00",
  "weight": 1.25,
  "length": 42.5,
  "released": true,
  "technique": "Spinnfiske",
  "notes": "Fin kväll, grått väder",
  "weather": "Molnigt, 12°C",
  "waterTemperature": "8°C"
}

### Uppdatera fångst
PUT {{FishingLog}}/api/catches/2ee08736-88b1-4be6-a87c-e39b0492fbc1
Content-Type: application/json

{
  "speciesId": "d02730c2-6253-4743-a383-d26ab70a5b75",
  "caughtAt": "2026-05-07T19:00:00",
  "weight": 1.5,
  "length": 45.0,
  "released": true
}

### Ta bort fångst
DELETE {{FishingLog}}/api/catches/f5ad641c-2a6e-4060-b96b-90557481388f

### ─── AUTH ───

### Registrera ny användare
POST {{FishingLog}}/api/auth/register
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "test123",
  "name": "Test Testsson"
}

### Logga in (testanvändaren från seeden)
POST {{FishingLog}}/api/auth/login
Content-Type: application/json

{
  "email": "karl@test.com",
  "password": "test123"
}